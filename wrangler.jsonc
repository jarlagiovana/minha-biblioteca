{
  "name": "api-biblioteca",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "biblioteca-db",
      "database_id": "4dd0efcf-b287-47c5-8ba9-ef3a686323f7"
    }
  ],
  // Rate limit: cada IP pode fazer no máximo 3 requisições a cada 60 segundos
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      // Número qualquer, único na sua conta Cloudflare
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    }
]
}